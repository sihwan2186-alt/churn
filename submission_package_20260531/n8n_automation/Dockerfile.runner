FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CHURN_WORKSPACE=/workspace

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY n8n_automation/requirements.runner.txt /tmp/requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements.txt

COPY n8n_automation/churn_runner.py /runner/churn_runner.py

EXPOSE 8000

CMD ["python", "/runner/churn_runner.py"]
